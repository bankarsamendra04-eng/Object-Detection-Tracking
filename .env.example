# ==============================================================================
# Object Detection & Tracking Platform - Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# DO NOT commit real production credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Environment
# ------------------------------------------------------------------------------
APP_NAME="Real-Time Object Detection & Tracking System"
# Application environment: "development", "staging", "production"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Allowed CORS Origins (JSON list or comma-separated string)
# For Docker deployments: include http://localhost, http://localhost:80, http://127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost","http://localhost:80"]

# ------------------------------------------------------------------------------
# Computer Vision & Model Inference
# ------------------------------------------------------------------------------
# Active model identifier corresponding to models/registry/models.yaml
ACTIVE_MODEL_ID=general_pretrained
MODEL_TYPE=pretrained
MODEL_NAME=yolov8n.pt
MODEL_VERSION=8.0
MODEL_SOURCE=ultralytics
MODELS_DIR=models
MODEL_WEIGHTS_DIR=models/weights
MODELS_REGISTRY_PATH=models/registry/models.yaml

# Inference Device: "auto" (selects cuda:0 if available, else cpu), "cuda:0", "cpu"
DEVICE=auto

# Detection Thresholds
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
HALF_PRECISION=false
MAX_DETECTIONS=100
INFERENCE_IMG_SIZE=640

# ------------------------------------------------------------------------------
# Multi-Object Tracker (ByteTrack)
# ------------------------------------------------------------------------------
TRACKER_TYPE=bytetrack.yaml
TRACK_PERSISTENCE_BUFFER=30
TRACK_HIGH_THRESH=0.5
TRACK_LOW_THRESH=0.1
TRACK_MATCH_THRESH=0.8

# ------------------------------------------------------------------------------
# Storage & Operational Directories
# ------------------------------------------------------------------------------
# Relative paths are automatically resolved relative to the repository root.
DATA_DIR=data
UPLOADS_DIR=data/uploads
OUTPUTS_DIR=outputs
LOGS_DIR=logs

# ------------------------------------------------------------------------------
# Database / Persistence Tier
# ------------------------------------------------------------------------------
# Local development default: SQLite database in data directory
# Docker default: sqlite:////app/data/detection_tracking.db
DATABASE_URL=sqlite:///./data/detection_tracking.db
DB_ECHO=false

# ------------------------------------------------------------------------------
# Real-Time Streaming & WebSocket Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_IMAGE_SIZE_BYTES=15728640   # 15 MB
MAX_UPLOAD_VIDEO_SIZE_BYTES=52428800   # 50 MB
MAX_IMAGE_DIMENSION=8192
MAX_CONCURRENT_WS_SESSIONS=10
MAX_WS_MESSAGE_SIZE_BYTES=65536        # 64 KB
MAX_STREAM_FPS=60.0

# ------------------------------------------------------------------------------
# Spatial Analytics & Tripwire Coordinates
# ------------------------------------------------------------------------------
LINE_CROSSING_COORDS=[[0,360],[1280,360]]
TARGET_CLASSES=[]
