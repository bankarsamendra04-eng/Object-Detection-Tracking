# ==============================================================================
# Docker Compose Environment Template (.env.docker.example)
# Rename to .env to customize docker compose runtime parameters.
# ==============================================================================

# Server Runtime
APP_NAME="Real-Time Object Detection & Tracking System"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost","http://localhost:80","http://127.0.0.1","http://127.0.0.1:80"]

# Vision Engine
ACTIVE_MODEL_ID=general_pretrained
MODEL_NAME=yolov8n.pt
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
HALF_PRECISION=false
INFERENCE_IMG_SIZE=640

# Persistence & Storage
DATABASE_URL=sqlite:////app/data/detection_tracking.db
DATA_DIR=/app/data
UPLOADS_DIR=/app/data/uploads
OUTPUTS_DIR=/app/outputs
LOGS_DIR=/app/logs

# Resource Protection
MAX_CONCURRENT_WS_SESSIONS=10
MAX_UPLOAD_IMAGE_SIZE_BYTES=15728640
MAX_UPLOAD_VIDEO_SIZE_BYTES=52428800
